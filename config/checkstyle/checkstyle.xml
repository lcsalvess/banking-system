<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Banking System Checkstyle configuration.

  Based on selected Google Java Style checks, adapted for this project:
  - two-space block indentation and four-space continuation indentation;
  - static imports first, followed by one alphabetically sorted group of
    non-static imports, with no blank lines inside that group;
  - a 100-character line limit;
  - Javadocs required on public types and methods, excluding constructors,
    property getters/setters, and DTO source files;
  - abbreviations written as words in names (e.g. AccountRequestDto);
  - Google-style Java text blocks;
  - no trailing whitespace or tab characters.

  Requires Checkstyle 14.4.0 (TextBlockGoogleStyleFormatting requires 12.3.0+).
-->
<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- Whitespace and file-level checks. -->
    <module name="FileTabCharacter">
        <property name="eachLine" value="true"/>
    </module>

    <module name="RegexpSingleline">
        <property name="id" value="NoTrailingWhitespace"/>
        <property name="format" value="\s+$"/>
        <property name="minimum" value="0"/>
        <property name="maximum" value="0"/>
        <property name="message" value="Trailing whitespace is not allowed."/>
    </module>

    <module name="NewlineAtEndOfFile"/>

    <module name="LineLength">
        <property name="fileExtensions" value="java"/>
        <property name="max" value="100"/>
        <property name="ignorePattern"
                  value="^(package|import) .*|https?://|ftp://"/>
    </module>

    <!-- Google-style Text Blocks are exempt from LineLength and Indentation. -->
    <module name="SuppressWithPlainTextCommentFilter">
        <property name="checkFormat" value="LineLength"/>
        <property name="offCommentFormat" value='^.*"""\s*$'/>
        <property name="onCommentFormat" value='^\s*"""\s*(?:[,;]|.+)$'/>
    </module>

    <module name="SuppressWithPlainTextCommentFilter">
        <property name="checkFormat" value="\.IndentationCheck$"/>
        <property name="offCommentFormat" value='^""".?'/>
        <property name="onCommentFormat" value='.'/>
    </module>

    <!-- Javadoc suppressions for DTO source files. -->
    <module name="SuppressionFilter">
        <property name="file" value="${config_loc}/suppressions.xml"/>
        <property name="optional" value="false"/>
    </module>

    <module name="TreeWalker">

        <!-- Imports: static imports first; all regular imports form one sorted group. -->
        <module name="CustomImportOrder">
            <property name="customImportOrderRules" value="STATIC, THIRD_PARTY_PACKAGE"/>
            <property name="thirdPartyPackageRegExp" value=".*"/>
            <property name="sortImportsInGroupAlphabetically" value="true"/>
            <property name="separateLineBetweenGroups" value="true"/>
        </module>

        <module name="AvoidStarImport"/>
        <module name="OneTopLevelClass"/>

        <!-- Core Google Java Style whitespace and brace rules. -->
        <module name="NeedBraces">
            <property name="tokens"
                      value="LITERAL_DO, LITERAL_ELSE, LITERAL_FOR, LITERAL_IF, LITERAL_WHILE"/>
        </module>
        <module name="LeftCurly"/>
        <module name="GoogleRightCurly"/>
        <module name="WhitespaceAfter"/>
        <module name="WhitespaceAround"/>
        <module name="ArrayBracketNoWhitespace"/>
        <module name="OneStatementPerLine"/>
        <module name="MultipleVariableDeclarations"/>
        <module name="ArrayTypeStyle"/>
        <module name="ModifierOrder"/>
        <module name="GenericWhitespace"/>
        <module name="MethodParamPad"/>
        <module name="ParenPad"/>
        <module name="NoWhitespaceBefore"/>
        <module name="NoWhitespaceBeforeCaseDefaultColon"/>

        <module name="EmptyLineSeparator">
            <property name="allowNoEmptyLineBetweenFields" value="true"/>
            <property name="allowMultipleEmptyLines" value="false"/>
        </module>

        <!-- Two-space Google-style indentation. -->
        <module name="Indentation">
            <property name="basicOffset" value="2"/>
            <property name="braceAdjustment" value="2"/>
            <property name="caseIndent" value="2"/>
            <property name="throwsIndent" value="4"/>
            <property name="lineWrappingIndentation" value="4"/>
            <property name="arrayInitIndent" value="2"/>
            <property name="forceStrictCondition" value="false"/>
        </module>

        <!-- Naming conventions. -->
        <module name="PackageName">
            <property name="format" value="^[a-z]+(\.[a-z][a-z0-9]*)*$"/>
        </module>

        <module name="TypeName">
            <property name="format" value="^[A-Z][a-zA-Z0-9]*$"/>
            <property name="tokens"
                      value="CLASS_DEF, INTERFACE_DEF, ENUM_DEF, ANNOTATION_DEF, RECORD_DEF"/>
        </module>

        <module name="GoogleMethodName"/>

        <!-- Abbreviations are treated as words, e.g. "AccountRequestDto", not "...DTO". -->
        <module name="AbbreviationAsWordInName">
            <property name="ignoreFinal" value="false"/>
            <property name="allowedAbbreviationLength" value="0"/>
            <property name="tokens"
                      value="CLASS_DEF, INTERFACE_DEF, ENUM_DEF, ANNOTATION_DEF,
                             ANNOTATION_FIELD_DEF, PARAMETER_DEF, VARIABLE_DEF, METHOD_DEF,
                             PATTERN_VARIABLE_DEF, RECORD_DEF, RECORD_COMPONENT_DEF"/>
        </module>

        <!-- Declarations and code structure. -->
        <module name="OverloadMethodsDeclarationOrder"/>
        <module name="VariableDeclarationUsageDistance"/>
        <module name="FallThrough"/>
        <module name="MissingSwitchDefault"/>
        <module name="UpperEll"/>
        <module name="NoFinalizer"/>

        <!-- Javadocs: public types and methods are documented; constructors are excluded. -->
        <module name="MissingJavadocType">
            <property name="scope" value="public"/>
            <property name="tokens"
                      value="CLASS_DEF, INTERFACE_DEF, ENUM_DEF, ANNOTATION_DEF, RECORD_DEF"/>
        </module>

        <module name="MissingJavadocMethod">
            <property name="scope" value="public"/>
            <property name="tokens" value="METHOD_DEF"/>
            <!-- Getters and setters of existing fields do not require Javadoc. -->
            <property name="allowMissingPropertyJavadoc" value="true"/>
        </module>

        <!-- Text blocks must follow Google Java Style formatting. -->
        <module name="TextBlockGoogleStyleFormatting"/>

    </module>
</module>
