<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suppressions PUBLIC
        "-//Checkstyle//DTD SuppressionFilter Configuration 1.2//EN"
        "https://checkstyle.org/dtds/suppressions_1_2.dtd">

<suppressions>

    <!-- DTOs do not require Javadocs for types or methods. -->
    <suppress
            checks="MissingJavadocType"
            files=".*[\\/]dto[\\/].*"/>

    <suppress
            checks="MissingJavadocMethod"
            files=".*[\\/]dto[\\/].*"/>

    <!-- Test classes do not require Javadocs. -->
    <suppress
            checks="MissingJavadocType"
            files=".*[\\/]src[\\/]test[\\/]java[\\/].*"/>

    <!-- Test methods do not require Javadocs. -->
    <suppress
            checks="MissingJavadocMethod"
            files=".*[\\/]src[\\/]test[\\/]java[\\/].*"/>
</suppressions>
