{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "America/Sao_Paulo",
  "schedule": [
    "every weekend"
  ],
  "enabledManagers": [
    "github-actions"
  ],
  "automerge": false,
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "service"
      ],
      "matchDepNames": [
        "postgres"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        ".github/workflows/ci.yml"
      ],
      "enabled": true
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "matchDepTypes": [
        "service"
      ],
      "matchDepNames": [
        "postgres"
      ],
      "matchDatasources": [
        "docker"
      ],
      "matchFileNames": [
        ".github/workflows/ci.yml"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch",
        "pin",
        "pinDigest",
        "lockFileMaintenance",
        "lockfileUpdate",
        "rollback",
        "bump",
        "replacement"
      ],
      "enabled": false
    }
  ]
}
